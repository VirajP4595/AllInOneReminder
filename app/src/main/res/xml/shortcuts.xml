<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon (#84). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_reminder"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="app.allinonereminder.action.ADD_REMINDER"
            android:targetPackage="app.allinonereminder"
            android:targetClass="app.allinonereminder.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_today_short"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="app.allinonereminder.action.OPEN_TODAY"
            android:targetPackage="app.allinonereminder"
            android:targetClass="app.allinonereminder.MainActivity" />
    </shortcut>
</shortcuts>
